{
  "name": "litwatch",
  "short_name": "litwatch",
  "description": "What is new in your field, read like a morning newspaper.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#faf7f1",
  "theme_color": "#faf7f1",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/papers",
    "method": "GET",
    "params": { "url": "url", "text": "text", "title": "title" }
  }
}
