# Copy to `.env` beside compose.yaml and fill in. Generate each token or password with
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'

# Secrets: Postgres's password, the web app's token, the deep service's read-only token (only
# needed with deep), and the token litwatch and the archive share.
LITWATCH_DB_PASSWORD=
LITWATCH_API_TOKEN=
LITWATCH_READ_TOKEN=
LITWATCH_ARCHIVE_TOKEN=

# Model providers (docs/specs/v1/models.md).
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# arXiv asks downloaders to say who they are: an address it can write to.
ARXIV_CONTACT=

# Optional: where the web app listens (127.0.0.1:8080), another configuration file, the image
# tag, and a Semantic Scholar key for the deep service.
# LITWATCH_BIND=127.0.0.1
# LITWATCH_PORT=8080
# LITWATCH_TOML=./litwatch.toml
# LITWATCH_TAG=local
# S2_API_KEY=
